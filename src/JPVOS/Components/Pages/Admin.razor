@page "/admin"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "FounderOnly")]

<div class="page-stack">
    <PageHero Kicker="Operations"
              Title="Protected operational review surface."
              Description="Authenticated founder access for governance review, incident routing, release coordination, and infrastructure operations."
              Image="@AssetPaths.JpvOs.Brand"
              ImageAlt="JPV-OS administrative routing interface" />

    <section class="content-section">
        <div class="feature-grid">
            <article class="glass-card"><h3>Governance Review</h3><p>Structured review paths for protected operational decisions.</p></article>
            <article class="glass-card"><h3>Incident Routing</h3><p>Security, access, and infrastructure event routing.</p></article>
            <article class="glass-card"><h3>Operational Integrity</h3><p>Protected workflows aligned with JPV-OS governance and evidence standards.</p></article>
        </div>
    </section>
</div>
