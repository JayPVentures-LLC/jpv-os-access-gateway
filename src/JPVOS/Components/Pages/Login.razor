@page "/login"
@page "/access/login"

<div class="public-page page-stack">
    <section class="public-hero" style="min-height: auto; padding: clamp(60px, 8vh, 100px) clamp(24px, 5vw, 80px);">
        <div class="public-hero-content">
            <p class="public-eyebrow">JPV Identity</p>
            <h1 class="public-title" style="font-size: clamp(2.2rem, 5vw, 3.5rem);">Sign in to JPV-OS</h1>
            <p class="public-subtitle">Authenticated access to your JPV profile, founder workspace, and governed operating surfaces.</p>
        </div>
    </section>

    <section class="public-section">
        <div class="glass-card" style="max-width: 620px; margin: 0 auto;">
            <form method="post" action="/api/auth/login" class="page-stack" autocomplete="on">
                <input type="hidden" name="returnUrl" value="/profile" />
                <label>
                    <span>Email</span>
                    <input name="email" type="email" autocomplete="username" required class="form-control" />
                </label>
                <label>
                    <span>Founder access key</span>
                    <input name="accessKey" type="password" autocomplete="current-password" required class="form-control" />
                </label>
                <button class="public-btn public-btn-primary" type="submit">Sign in</button>
            </form>
            <p class="public-subtitle" style="margin-top: 20px;">Founder identity is independent from customer payment entitlement and Discord community routing.</p>
        </div>
    </section>

    <section class="public-section">
        <div class="public-access-grid">
            <a class="public-access-card" href="/access"><span>Member</span><strong>Member access</strong><p>Customer entitlement and ecosystem routing.</p></a>
            <a class="public-access-card" href="/partners"><span>Partner</span><strong>Partner access</strong><p>Partner governance and collaboration routing.</p></a>
            <a class="public-access-card" href="/jaypventures-llc"><span>Enterprise</span><strong>Enterprise access</strong><p>Enterprise qualification and infrastructure workflows.</p></a>
        </div>
    </section>
</div>
