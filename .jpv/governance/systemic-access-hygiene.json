  "re_enable_requires": "explicit_current_authorization",
  "least_privilege": true,
  "preserve_audit_receipt": true,
  "regression_requirements": ["authentication","authorization","routing","dependency_health","founder_access"],
  "interpretation": {
    "systemic_only": true,
    "person_targeting": false
  },
  "completion": "zero_invalid_access_or_owned_review_state"
}
